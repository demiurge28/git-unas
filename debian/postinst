#!/bin/sh
# Post-install script for git-unas.
set -e

CONFIG_DIR=/etc/git-unas
LIBEXEC=/usr/libexec/git-unas
DATA_DIR=/data/git-unas

case "$1" in
    configure)
        # Create config directory.
        mkdir -p "$CONFIG_DIR"
        chmod 700 "$CONFIG_DIR"

        # Generate AUTH_SECRET on first install if not already set.
        LOCAL_DEFAULTS=/etc/default/git-unas.local
        if ! grep -q 'AUTH_SECRET' "$LOCAL_DEFAULTS" 2>/dev/null; then
            SECRET=$(openssl rand -hex 32 2>/dev/null || cat /proc/sys/kernel/random/uuid | tr -d '-')
            mkdir -p "$(dirname $LOCAL_DEFAULTS)"
            echo "AUTH_SECRET=${SECRET}" >> "$LOCAL_DEFAULTS"
        fi

        # Inject nginx proxy block (best effort — non-fatal on non-UNAS).
        if [ -x "$LIBEXEC/nginx-inject.sh" ]; then
            "$LIBEXEC/nginx-inject.sh" || true
        fi

        # Refresh the persistent recovery installer so boot-restore reinstalls
        # with the current dependency-resolving installer after a firmware wipe.
        if [ -f "$LIBEXEC/install.sh" ] && [ -d /data ]; then
            mkdir -p "$DATA_DIR"
            cp "$LIBEXEC/install.sh" "$DATA_DIR/install.sh" 2>/dev/null || true
            chmod 0755 "$DATA_DIR/install.sh" 2>/dev/null || true
        fi

        # Reload systemd and enable/start the service.
        systemctl daemon-reload
        # Reset any previous failure/crash-loop state so the service
        # can start even after many consecutive failures.
        systemctl reset-failed git-unas.service 2>/dev/null || true

        # Enable the self-healing nginx units: the path watcher re-runs the
        # injector whenever UniFi regenerates its site config, and the oneshot
        # heals once at boot. Best-effort — non-fatal on non-UNAS systems.
        systemctl enable git-unas-nginx.path git-unas-nginx.service 2>/dev/null || true
        systemctl start git-unas-nginx.path 2>/dev/null || true

        if [ -z "$2" ]; then
            # Fresh install.
            systemctl enable --now git-unas.service
        else
            # Upgrade: re-inject nginx (picks up any config changes) and
            # restart the service to pick up the new binary.
            if [ -x "$LIBEXEC/nginx-inject.sh" ]; then
                "$LIBEXEC/nginx-inject.sh" || true
            fi
            systemctl enable git-unas.service
            systemctl try-restart git-unas.service || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
